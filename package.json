{
    "name": "forest-vision-root",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "postinstall": "cd Backend && npm install && cd ../Frontend && npm install",
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "start": "npm run dev",
        "server": "cd Backend && npm start",
        "client": "cd Frontend && npm run dev"
    },
    "devDependencies": {
        "concurrently": "^9.1.0"
    },
    "dependencies": {
        "dotenv": "^17.2.3",
        "mongodb": "^7.0.0",
        "mongoose": "^9.1.4"
    }
}
